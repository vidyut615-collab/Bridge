# Database Connection
# For local zero-setup development: SQLite
DATABASE_URL="file:./dev.db"
# For Vercel Postgres / Supabase / Neon in production:
# DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Groq API for Multimodal Blueprint Vision Extraction
# Get your API key from https://console.groq.com
GROQ_API_KEY=""

# Application JWT Authentication Secret (Generate a secure random 32+ character string)
JWT_SECRET=""

# Optional Seed Credentials (Used only during initial local database seeding)
# SEED_ADMIN_PASSWORD=""
# SEED_STAFF_PASSWORD=""

# Application Settings
NEXT_PUBLIC_APP_TIMEZONE="Asia/Kolkata"

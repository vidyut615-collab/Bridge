datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. User & Authentication
// ----------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // "SUPERADMIN" | "STAFF"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  examsCreated             Exam[]
  inventoryHistories       InventoryHistory[]
  auditLogs                AuditLog[]
  examVersions             ExamVersion[]
  testpressCompletedExams  ExamPlatformStatus[] @relation("TestpressCompletedByUser")
  lmsCompletedExams        ExamPlatformStatus[] @relation("LmsCompletedByUser")
  platformUpdateHistories  PlatformUpdateHistory[]
  blueprintUploads         BlueprintUpload[]
}

// ----------------------------------------------------
// 2. Master Data: Colleges
// ----------------------------------------------------
model College {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique // e.g. "DYPCOE", "SBUP", "JSPM"
  isArchived Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exams           Exam[]
  namingSequences NamingSequence[]
}

// ----------------------------------------------------
// 3. Master Data: Subjects & Topics
// ----------------------------------------------------
model Subject {
  id         String   @id @default(uuid())
  name       String   @unique
  isArchived Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topics                Topic[]
  inventoryRecords      QuestionBankInventory[]
  inventoryHistories    InventoryHistory[]
  examSections          ExamSection[]
}

model Topic {
  id         String   @id @default(uuid())
  topicCode  String   @unique // e.g. "TOP-00001"
  subjectId  String
  name       String
  isArchived Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examSectionTopics ExamSectionTopic[]

  @@unique([subjectId, name])
}

// ----------------------------------------------------
// 4. Question Bank Observability
// ----------------------------------------------------
model QuestionBankInventory {
  id              String   @id @default(uuid())
  subjectId       String
  difficultyLevel String   // "I_EASY", "II_MEDIUM", "III_HARD"
  folderName      String   @default("")
  questionCount   Int      @default(0)
  lastUpdatedBy   String
  updatedAt       DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, difficultyLevel])
}

model InventoryHistory {
  id                String   @id @default(uuid())
  subjectId         String
  prevEasy          Int
  newEasy           Int
  prevMedium        Int
  newMedium         Int
  prevHard          Int
  newHard           Int
  prevFolders       String   // JSON string of folder names
  newFolders        String   // JSON string of folder names
  changeDescription String   // Mandatory reason
  changedBy         String
  createdAt         DateTime @default(now())

  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  changedByUser User   @relation(fields: [changedBy], references: [id])
}

// ----------------------------------------------------
// 5. Naming Sequences (College + Category)
// ----------------------------------------------------
model NamingSequence {
  id              String   @id @default(uuid())
  collegeId       String
  category        String   // "TR" (Training) | "RG" (Regular)
  currentSequence Int      @default(0)
  updatedAt       DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, category])
}

// ----------------------------------------------------
// 6. Examination Registry & Metadata
// ----------------------------------------------------
model Exam {
  id              String    @id @default(uuid())
  examId          String    @unique // e.g. "EXM-0001"
  category        String    // "GLOBAL", "COLLEGE_TRAINING", "COLLEGE_REGULAR"
  collegeId       String?
  title           String    // Staff entered title
  generatedName   String    @unique // e.g. "DYPCOE-TR-Aptitude Assessment-001"
  uniqueCode      String    // e.g. "001"
  testType        String    @default("PUBLIC") // "PUBLIC" | "PRIVATE"
  durationMinutes Int       @default(60)
  totalMarks      Float     @default(100)
  marksCorrect    Float     @default(1)
  marksIncorrect  Float     @default(0)
  startDate       DateTime?
  endDate         DateTime?
  attemptPolicy   String    @default("UNLIMITED") // "UNLIMITED" | "LIMITED"
  maxAttempts     Int?
  overallStatus   String    @default("DRAFT") // "DRAFT", "READY_FOR_TESTPRESS", "TESTPRESS_PENDING", "LMS_PENDING", "COMPLETED", "ON_HOLD", "CANCELLED"
  currentVersion  Int       @default(1)
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  college                College?                @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  createdByUser          User                    @relation(fields: [createdBy], references: [id])
  sections               ExamSection[]
  platformStatus         ExamPlatformStatus?
  platformUpdateHistories PlatformUpdateHistory[]
  versions               ExamVersion[]
}

// ----------------------------------------------------
// 7. Exam Sections & Composition Builder
// ----------------------------------------------------
model ExamSection {
  id          String   @id @default(uuid())
  examId      String
  subjectId   String
  sectionName String   // e.g. "Arithmetic Core"
  sortOrder   Int      @default(0)

  exam            Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject         Subject            @relation(fields: [subjectId], references: [id])
  topics          ExamSectionTopic[]
  blueprintUploads BlueprintUpload[]
}

model ExamSectionTopic {
  id                    String  @id @default(uuid())
  sectionId             String
  topicId               String
  questionCount         Int     @default(0)
  level1Easy            Int     @default(0)
  level2Medium          Int     @default(0)
  level3Hard            Int     @default(0)
  compositionPercentage Float   @default(0.0)

  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic   Topic       @relation(fields: [topicId], references: [id])

  @@unique([sectionId, topicId])
}

// ----------------------------------------------------
// 8. AI Blueprint Uploads
// ----------------------------------------------------
model BlueprintUpload {
  id               String   @id @default(uuid())
  sectionId        String
  imageUrl         String   // Path or URL to stored image
  rawExtractedJson String   // JSON string of LLM extraction response
  extractionStatus String   @default("EXTRACTED") // "PENDING", "EXTRACTED", "RESOLVED", "APPROVED"
  uploadedBy       String
  createdAt        DateTime @default(now())

  section        ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  uploadedByUser User        @relation(fields: [uploadedBy], references: [id])
}

// ----------------------------------------------------
// 9. Deployment Lifecycle & Subsequent Updates
// ----------------------------------------------------
model ExamPlatformStatus {
  id                     String    @id @default(uuid())
  examId                 String    @unique
  testpressStatus        String    @default("PENDING") // "PENDING" | "COMPLETED"
  testpressCompletedAt   DateTime?
  testpressCompletedBy   String?
  testpressNotes         String?
  lmsStatus              String    @default("PENDING") // "PENDING" | "COMPLETED"
  lmsCompletedAt         DateTime?
  lmsCompletedBy         String?
  lmsNotes               String?
  testpressUpdatePending Boolean   @default(false)
  lmsUpdatePending       Boolean   @default(false)

  exam                     Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  testpressCompletedByUser User? @relation("TestpressCompletedByUser", fields: [testpressCompletedBy], references: [id])
  lmsCompletedByUser       User? @relation("LmsCompletedByUser", fields: [lmsCompletedBy], references: [id])
}

model PlatformUpdateHistory {
  id                String   @id @default(uuid())
  examId            String
  platform          String   // "TESTPRESS" | "TRUSKILL_LMS"
  action            String   // "UPDATE_PENDING" | "UPDATE_CONFIRMED"
  changeDescription String
  confirmedBy       String
  createdAt         DateTime @default(now())

  exam            Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  confirmedByUser User @relation(fields: [confirmedBy], references: [id])
}

model ExamVersion {
  id                String   @id @default(uuid())
  examId            String
  versionNumber     Int
  snapshotData      String   // Complete JSON serialization of exam metadata & composition
  changeDescription String   // Mandatory description
  changedBy         String
  createdAt         DateTime @default(now())

  exam          Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  changedByUser User @relation(fields: [changedBy], references: [id])

  @@unique([examId, versionNumber])
}

// ----------------------------------------------------
// 10. Audit Log & Change Tracking
// ----------------------------------------------------
model AuditLog {
  id                String   @id @default(uuid())
  entityType        String   // "QUESTION_BANK", "MASTER_DATA", "EXAMINATION", "PLATFORM_STATUS"
  entityId          String
  action            String   // "CREATE", "UPDATE", "RENAME", "ARCHIVE", "COMPLETION", "VERSION_INCREMENT"
  prevValue         String?  // JSON string
  newValue          String?  // JSON string
  changeDescription String   // Mandatory
  changedBy         String
  createdAt         DateTime @default(now())

  changedByUser User @relation(fields: [changedBy], references: [id])
}

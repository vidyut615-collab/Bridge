datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. User & Authentication
// ----------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // "SUPERADMIN" | "STAFF"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  examsCreated             Exam[]
  topicInventoryHistories  TopicInventoryHistory[]
  auditLogs                AuditLog[]
  examVersions             ExamVersion[]
  testpressCompletedExams  ExamPlatformStatus[] @relation("TestpressCompletedByUser")
  lmsCompletedExams        ExamPlatformStatus[] @relation("LmsCompletedByUser")
  platformUpdateHistories  PlatformUpdateHistory[]
  blueprintUploads         BlueprintUpload[]
}

// ----------------------------------------------------
// 2. Master Data: Colleges
// ----------------------------------------------------
model College {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique // e.g. "DYPCOE", "SBUP", "JSPM"
  isArchived Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exams           Exam[]
  namingSequences NamingSequence[]
}

// ----------------------------------------------------
// 3. Master Data: Subjects & Topics
// ----------------------------------------------------
model Subject {
  id         String   @id @default(uuid())
  name       String   @unique
  isArchived Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topics                Topic[]
  examSections          ExamSection[]
}

model Topic {
  id         String   @id @default(uuid())
  topicCode  String   @unique // e.g. "TOP-00001"
  subjectId  String
  name       String
  isArchived Boolean  @default(false)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 3 Difficulty Levels per Topic (Level I Easy, Level II Medium, Level III Hard)
  easyCount   Int     @default(0)
  mediumCount Int     @default(0)
  hardCount   Int     @default(0)
  folderName  String  @default("")

  subject                Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examSectionTopics      ExamSectionTopic[]
  inventoryHistories     TopicInventoryHistory[]

  @@unique([subjectId, name])
}

// ----------------------------------------------------
// 4. Topic Inventory Observability & History
// ----------------------------------------------------
model TopicInventoryHistory {
  id                String   @id @default(uuid())
  topicId           String
  prevEasy          Int
  newEasy           Int
  prevMedium        Int
  newMedium         Int
  prevHard          Int
  newHard           Int
  prevFolder        String   @default("")
  newFolder         String   @default("")
  changeDescription String   // Mandatory reason
  changedBy         String
  createdAt         DateTime @default(now())

  topic         Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  changedByUser User  @relation(fields: [changedBy], references: [id])
}

// ----------------------------------------------------
// 5. Naming Sequences (College + Category)
// ----------------------------------------------------
model NamingSequence {
  id              String   @id @default(uuid())
  collegeId       String
  category        String   // "TR" (Training) | "RG" (Regular)
  currentSequence Int      @default(0)
  updatedAt       DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, category])
}

// ----------------------------------------------------
// 6. Examination Registry & Metadata
// ----------------------------------------------------
model Exam {
  id              String   @id @default(uuid())
  examId          String   @unique // Internal ID e.g. "EXAM-00001"
  category        String   // "GLOBAL" | "COLLEGE_TRAINING" | "COLLEGE_REGULAR"
  collegeId       String?
  title           String   // User-entered title
  generatedName   String   @unique // Standardized e.g. "DYPCOE-TR-PLACEMENT-001"
  uniqueCode      String   // Generated sequence e.g. "DYPCOE-TR-001" or "GLOBAL-00001"
  testType        String   @default("PRIVATE") // "PUBLIC" | "PRIVATE"
  durationMinutes Int
  totalMarks      Float
  marksCorrect    Float    @default(1.0)
  marksIncorrect  Float    @default(0.0)
  startDate       DateTime?
  endDate         DateTime?
  attemptPolicy   String   @default("UNLIMITED") // "UNLIMITED" | "LIMITED"
  maxAttempts     Int?
  overallStatus   String   @default("DRAFT") // "DRAFT" | "READY_FOR_TESTPRESS" | "LMS_PENDING" | "COMPLETED"
  currentVersion  Int      @default(1)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  college                 College?                @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  createdByUser           User                    @relation(fields: [createdBy], references: [id])
  sections                ExamSection[]
  versions                ExamVersion[]
  platformStatus          ExamPlatformStatus?
  platformUpdateHistories PlatformUpdateHistory[]
  blueprintUploads        BlueprintUpload[]
}

// ----------------------------------------------------
// 7. Examination Sections & Composition
// ----------------------------------------------------
model ExamSection {
  id          String   @id @default(uuid())
  examId      String
  subjectId   String
  sectionName String   // e.g. "Aptitude Section 1"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam    Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topics  ExamSectionTopic[]
}

model ExamSectionTopic {
  id                    String   @id @default(uuid())
  sectionId             String
  topicId               String
  questionCount         Int
  compositionPercentage Float    @default(0.0)
  level1Easy            Int      @default(0)
  level2Medium          Int      @default(0)
  level3Hard            Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic   Topic       @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([sectionId, topicId])
}

// ----------------------------------------------------
// 8. Examination Versioning (Strict Immutable Specs)
// ----------------------------------------------------
model ExamVersion {
  id                String   @id @default(uuid())
  examId            String
  versionNumber     Int      // 1, 2, 3...
  snapshotJson      String   @default("{}") // Full immutable JSON snapshot of exam metadata & composition
  snapshotData      String?  // Backward-compatible alias
  changeDescription String   // Mandatory reason for version change
  changedBy         String
  createdAt         DateTime @default(now())

  exam          Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  changedByUser User @relation(fields: [changedBy], references: [id])

  @@unique([examId, versionNumber])
}

// ----------------------------------------------------
// 9. Two-Stage Platform Deployment & Observability
// ----------------------------------------------------
model ExamPlatformStatus {
  id                     String    @id @default(uuid())
  examId                 String    @unique
  testpressStatus        String    @default("PENDING") // "PENDING" | "COMPLETED"
  testpressCompletedAt   DateTime?
  testpressCompletedBy   String?
  testpressNotes         String?
  lmsStatus              String    @default("PENDING") // "PENDING" | "COMPLETED"
  lmsCompletedAt         DateTime?
  lmsCompletedBy         String?
  lmsNotes               String?
  testpressUpdatePending Boolean   @default(false)
  lmsUpdatePending       Boolean   @default(false)
  updatedAt              DateTime  @updatedAt

  exam                     Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  testpressCompletedByUser User? @relation("TestpressCompletedByUser", fields: [testpressCompletedBy], references: [id])
  lmsCompletedByUser       User? @relation("LmsCompletedByUser", fields: [lmsCompletedBy], references: [id])
}

model PlatformUpdateHistory {
  id                String   @id @default(uuid())
  examId            String
  platform          String   // "TESTPRESS" | "TRUSKILL_LMS"
  action            String   // "UPDATE_REQUIRED" | "UPDATE_CONFIRMED"
  changeDescription String
  confirmedBy       String
  createdAt         DateTime @default(now())

  exam            Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  confirmedByUser User @relation(fields: [confirmedBy], references: [id])
}

// ----------------------------------------------------
// 10. AI Vision Blueprint Processing Audit
// ----------------------------------------------------
model BlueprintUpload {
  id               String   @id @default(uuid())
  examId           String?
  sectionId        String
  uploadedBy       String
  imageUrl         String?
  rawExtractedJson String?
  rawResponseText  String   @default("")
  extractionStatus String   @default("SUCCESS")
  status           String   @default("SUCCESS")
  createdAt        DateTime @default(now())

  exam Exam? @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [uploadedBy], references: [id])
}

// ----------------------------------------------------
// 11. Immutable Audit Log & Accountability
// ----------------------------------------------------
model AuditLog {
  id                String   @id @default(uuid())
  entityType        String   // "QUESTION_BANK" | "EXAM" | "MASTER_COLLEGE" | "MASTER_SUBJECT" | "MASTER_TOPIC" | "DEPLOYMENT"
  entityId          String
  action            String   // "CREATE" | "UPDATE" | "ARCHIVE" | "RESTORE" | "COMPLETION" | "RENAME"
  changeDescription String   // Mandatory reason
  changedBy         String
  previousValues    String?  // JSON string
  newValues         String?  // JSON string
  createdAt         DateTime @default(now())

  changedByUser User @relation(fields: [changedBy], references: [id])
}
